# ---------------------------------------------------------------
# LeadFlow AI — переменные окружения.
# Скопируйте в .env в корне монорепозитория: cp .env.example .env
# Веб-приложение, worker, seed и collector читают этот единый файл.
# ---------------------------------------------------------------

# Режим демонстрации: AI-ответы детерминированные, сообщения только симулируются.
DEMO_MODE=true

# PostgreSQL
DATABASE_URL=postgresql://leadflow:leadflow@localhost:5432/leadflow
# Отдельная БД для интеграционных тестов (будет очищаться!)
TEST_DATABASE_URL=postgresql://leadflow:leadflow@localhost:5432/leadflow_test

# Redis (BullMQ). Если пусто — задания выполняются в процессе веб-сервера.
REDIS_URL=redis://localhost:6379

# Better Auth: длинная случайная строка (openssl rand -base64 32)
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Разрешить регистрацию новых пользователей (false — только приглашённые/seed)
ALLOW_SIGNUP=true

# Ключ шифрования секретов интеграций: 32 байта в base64 (openssl rand -base64 32)
ENCRYPTION_KEY=

# Anthropic Claude API (необязательно; без ключа работает DEMO_MODE)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Ограничения расходов
AI_MAX_OUTPUT_TOKENS=4000
AI_TIMEOUT_MS=60000
AI_MONTHLY_BUDGET_USD=20

# Python collector (FastAPI)
COLLECTOR_URL=http://localhost:8001
COLLECTOR_TOKEN=change-me-collector-token

# Источники поиска клиентов (необязательно; читает collector)
# Яндекс Search API (Yandex Cloud): поиск сайтов компаний по нише и городу
YANDEX_SEARCH_API_KEY=
YANDEX_FOLDER_ID=
# Справочник 2ГИС (platform.2gis.ru): организации по нише и городу с контактами
TWOGIS_API_KEY=
# DaData: реквизиты организаций по названию или ИНН
DADATA_API_KEY=

# SMTP для отправки email (необязательно; в DEMO_MODE отправка только симулируется)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Playwright Chromium для PDF (если не задано — используется установленный Playwright)
PDF_CHROMIUM_PATH=
